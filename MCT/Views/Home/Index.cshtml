@model IEnumerable<MCT.Models.Match>
@{
    ViewData["Title"] = "HOME";
    var rankingsList = (ViewBag.Rankings as IEnumerable<MCT.Models.LeaderboardViewModel>)?.ToList() ?? new List<MCT.Models.LeaderboardViewModel>();
    var topTeams = rankingsList.Take(3).ToList();
    int maxRounds = topTeams.Any() ? topTeams.Max(t => Math.Max(t.WonRounds, t.LostRounds)) : 10;
    int chartMax = maxRounds > 0 ? (int)(maxRounds * 1.1) : 10;
}

<div class="d-flex justify-content-center align-items-center flex-column mb-4 pt-4 mt-2">
    <h1 class="text-white m-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 4rem; line-height: 1.2;">LIVE EVENTS</h1>
</div>

<div class="d-flex mx-auto" style="max-width: 1400px; gap: 30px; height: calc(100vh - 240px);">
    
    <div style="width: 350px; flex-shrink: 0; align-self: flex-start;">
        <div class="val-card-chart p-4" style="height: 420px;">
            <h3 class="text-white mb-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem;">ROUNDS STATISTICS</h3>
            <p class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">TOP 3 TEAMS // WON VS LOST</p>

            <div class="chart-area">
                <div class="y-axis">
                    <span>0</span>
                    <span>@(chartMax / 2)</span>
                    <span>@chartMax</span>
                </div>
                <div class="chart-team-bars">
                    @for (int i = 0; i < 3; i++)
                    {
                        if (i < topTeams.Count)
                        {
                            var team = topTeams[i];
                            double wonPct = chartMax > 0 ? Math.Min(100, (double)team.WonRounds / chartMax * 100) : 0;
                            double lostPct = chartMax > 0 ? Math.Min(100, (double)team.LostRounds / chartMax * 100) : 0;
                            <div class="team-bar-group">
                                <div class="bar-container">
                                    <div class="bar won" style="height: @(wonPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%;" data-rounds="@team.WonRounds"></div>
                                    <div class="bar lost" style="height: @(lostPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%;" data-rounds="@team.LostRounds"></div>
                                </div>
                                <a asp-controller="Teams" asp-action="Details" asp-route-id="@team.TeamId" class="team-label-link" title="@team.ShortCode">@team.ShortCode</a>
                            </div>
                        }
                        else
                        {
                            <div class="team-bar-group">
                                <div class="bar-container"><div class="bar won" style="height: 0%;"></div><div class="bar lost" style="height: 0%;"></div></div>
                                <span class="team-label-link text-muted">N/A</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="matches-scroll-container flex-grow-1" style="height: 100%; overflow-y: auto; padding-right: 15px;">
        @if (!Model.Any())
        {
            <div class="text-center text-white mt-5 font-monospace">NO MATCHES SCHEDULED</div>
        }
        else
        {
            foreach (var match in Model)
            {
                bool isLive = match.ScheduledAt?.Date == DateTime.UtcNow.Date;
                <div class="val-card mb-4 p-3 @(isLive ? "val-card-live" : "")">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
                        <span class="text-white fw-bold">@(isLive ? "🔴 LIVE TODAY" : match.ScheduledAt?.ToString("MM/dd/yyyy HH:mm") ?? "TBD")</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-end" style="flex: 1;"><h3 class="text-white m-0">@(match.TeamA?.ShortCode ?? "TBD")</h3></div>
                        <div class="text-center px-4" style="min-width: 150px;">
                            <h2 class="m-0 text-val-red" style="font-family: 'Bebas Neue', sans-serif; font-size: 3rem;">@(match.ScoreA ?? 0) <span class="text-secondary">-</span> @(match.ScoreB ?? 0)</h2>
                            <div class="text-white text-uppercase mt-1" style="font-size: 0.85rem;">@(match.Tournament?.Description ?? "TBD")</div>
                        </div>
                        <div class="text-start" style="flex: 1;"><h3 class="text-white m-0">@(match.TeamB?.ShortCode ?? "TBD")</h3></div>
                        <div class="border-start border-secondary ps-4 ms-3"><a asp-controller="Matches" asp-action="Details" asp-route-id="@match.MatchId" class="btn-outline-val w-100">VIEW DETAILS</a></div>
                    </div>
                </div>
            }
        }
    </div>

    <div style="width: 350px; flex-shrink: 0; align-self: flex-start;">
        <div class="val-card-leaderboard p-4 d-flex flex-column" style="height: 420px;">
            <h3 class="text-white mb-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem;">GLOBAL RANKINGS</h3>
            <p class="text-muted text-uppercase mb-4" style="font-size: 0.75rem; letter-spacing: 1px;">SORTED BY ROUND WIN %</p>

            <table class="table table-dark table-borderless mb-0 align-middle">
                <tbody>
                    @for (int i = 0; i < 3; i++)
                    {
                        <tr class="border-bottom border-secondary" style="height: 60px;">
                            @if (i < rankingsList.Count)
                            {
                                var team = rankingsList[i];
                                double total = team.WonRounds + team.LostRounds;
                                double winPercent = total > 0 ? (team.WonRounds / total) * 100 : 0;
                                <td class="text-white fw-bold fs-4" style="width: 40px;">@(i + 1)</td>
                                <td class="fw-bold fs-4">
                                    <a asp-controller="Teams" asp-action="Details" asp-route-id="@team.TeamId" class="text-white text-decoration-none hover-val-red">@team.ShortCode</a>
                                </td>
                                <td class="text-end text-val-orange fw-bold fs-4">@winPercent.ToString("0.0")%</td>
                            }
                            else
                            {
                                <td class="text-muted fw-bold fs-4" style="width: 40px;">@(i + 1)</td>
                                <td class="fw-bold fs-4 text-muted">N/A</td>
                                <td class="text-end text-muted fw-bold fs-4">0%</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            
            <div class="mt-auto pt-2 text-center">
                <a asp-controller="Leaderboard" asp-action="Index" class="btn-outline-val" style="display: block; box-sizing: border-box; padding: 8px 0;">VIEW FULL RANKINGS</a>
            </div>
        </div>
    </div>
</div>