@model IEnumerable<MCT.Models.LeaderboardViewModel>
@{
    ViewData["Title"] = "LEADERBOARD";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">GLOBAL RANKINGS</h3>
    </div>

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="border-bottom border-secondary text-muted">
                <tr>
                    <th class="fw-normal text-center" style="letter-spacing: 1px; width: 80px;">RANK</th>
                    <th class="fw-normal" style="letter-spacing: 1px;">TEAM</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">MATCHES</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">WIN %</th>
                    <th class="fw-normal text-end" style="letter-spacing: 1px;">ROUND DIFF</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rank = 1;
                }
                @foreach (var team in Model)
                {
                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-center text-white fw-bold fs-4">@rank</td>
                        <td class="fw-bold fs-5">
                            <a asp-controller="Teams" asp-action="Details" asp-route-id="@team.TeamId" class="text-white text-decoration-none hover-val-red d-flex align-items-center gap-2">
                                @team.TeamName
                                <span class="badge bg-dark border border-secondary text-val-orange font-monospace fs-6">@team.ShortCode</span>
                            </a>
                        </td>
                        <td class="text-center font-monospace fs-5">@team.MatchesPlayed</td>
                        <td class="text-center text-val-red fw-bold fs-4 font-monospace">@team.WinPercentage.ToString("0.0")%</td>
                        <td class="text-end text-val-orange fw-bold fs-4 font-monospace">
                            @(team.Diff > 0 ? "+" + team.Diff : team.Diff.ToString())
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>