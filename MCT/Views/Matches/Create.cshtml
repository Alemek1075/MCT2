@model MCT.Models.Match

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Match</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Tournament" class="control-label"></label>
                <select asp-for="TournamentId" class="form-control" asp-items="ViewBag.Tournament">
                    <option value="">-- Оберіть турнір --</option>
                </select>
                <span asp-validation-for="TournamentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TeamA" class="control-label"></label>
                <select asp-for="TeamAId" class="form-control" asp-items="ViewBag.TeamA">
                    <option value="">-- Оберіть команду А --</option>
                </select>
                <span asp-validation-for="TeamAId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TeamB" class="control-label"></label>
                <select asp-for="TeamBId" class="form-control" asp-items="ViewBag.TeamB">
                    <option value="">-- Оберіть команду Б --</option>
                </select>
                <span asp-validation-for="TeamBId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ScheduledAt" class="control-label"></label>
                <input asp-for="ScheduledAt" class="form-control" />
                <span asp-validation-for="ScheduledAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ScoreA" class="control-label"></label>
                <input asp-for="ScoreA" class="form-control" />
                <span asp-validation-for="ScoreA" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ScoreB" class="control-label"></label>
                <input asp-for="ScoreB" class="form-control" />
                <span asp-validation-for="ScoreB" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MatchType" class="control-label"></label>
                <select asp-for="MatchType" class="form-control" asp-items="ViewBag.MatchType">
                    <option value="">-- Оберіть тип матчу --</option>
                </select>
                <span asp-validation-for="MatchType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}