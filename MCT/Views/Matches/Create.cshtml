@model MCT.Models.Match
@{
    ViewData["Title"] = "CREATE MATCH";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">MANUAL MATCH CREATION</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold bg-dark p-2 border border-danger rounded"></div>

        <div class="val-card p-4 mb-4">
            <div class="mb-4">
                <label asp-for="TournamentId" class="form-label">EVENT</label>
                <select asp-for="TournamentId" class="form-select" asp-items="ViewBag.TournamentId"></select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="TeamAId" class="form-label">TEAM A</label>
                    <select asp-for="TeamAId" class="form-select" asp-items="ViewBag.TeamAId"></select>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="TeamBId" class="form-label">TEAM B</label>
                    <select asp-for="TeamBId" class="form-select" asp-items="ViewBag.TeamBId"></select>
                    <span asp-validation-for="TeamBId" class="text-danger d-block mt-1 fw-bold"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ScheduledAt" class="form-label">SCHEDULED AT</label>
                    <input asp-for="ScheduledAt" type="datetime-local" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MatchType" class="form-label">MATCH TYPE</label>
                    <select asp-for="MatchType" class="form-select" asp-items="ViewBag.MatchType"></select>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">CREATE MATCH</button>
        </div>
    </form>
</div>