@model MCT.Models.Match
@{
    ViewData["Title"] = "DELETE MATCH";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">DELETE MATCH CONFIRMATION</h3>
    
    <div class="alert alert-danger bg-dark border-danger text-white mb-4 fs-6 fw-bold">
        Are you sure you want to delete this match?
    </div>

    <div class="p-4 mb-4 text-center" style="background-color: #111111; border-radius: 8px; border-left: 4px solid #ff4655;">
        <div class="row align-items-center mb-3">
            <div class="col text-end">
                <h3 class="text-white m-0 fw-bold fs-4">@(Model.TeamA?.Name ?? "TBD")</h3>
            </div>
            <div class="col-auto px-3">
                <h1 class="m-0 text-val-red fw-bold fs-3" style="font-family: 'Bebas Neue', sans-serif;">VS</h1>
            </div>
            <div class="col text-start">
                <h3 class="text-white m-0 fw-bold fs-4">@(Model.TeamB?.Name ?? "TBD")</h3>
            </div>
        </div>
        
        <div class="border-top border-secondary pt-3 mt-3 text-start">
            <label class="form-label text-muted d-block mb-1">EVENT</label>
            <p class="text-white fs-5 m-0">@(Model.Tournament?.Description ?? "TBD")</p>
        </div>

        <div class="border-top border-secondary pt-3 mt-3 text-start">
            <label class="form-label text-muted d-block mb-1">DATE & TIME</label>
            <p class="text-white fs-5 m-0">@(Model.ScheduledAt?.ToString("MM/dd/yyyy HH:mm") ?? "TBD")</p>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MatchId" />
        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-danger-val">PERMANENTLY DELETE</button>
        </div>
    </form>
</div>