@model MCT.Models.Match
@{
    ViewData["Title"] = "MATCH DETAILS";
    var today = DateTime.UtcNow.Date;
    bool isLive = Model?.ScheduledAt?.Date == today;
}

<div class="page-container mx-auto" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <h3 class="mb-0 text-val-red">MATCH DETAILS</h3>
        <a asp-action="Index" class="btn-outline-val" style="font-size: 1rem;">BACK TO LIST</a>
    </div>

    <div class="text-center mb-4">
        <h5 class="text-val-orange" style="letter-spacing: 2px;">EVENT // @(Model?.Tournament?.Description ?? "TBD")</h5>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-5 px-4">
        <div class="text-end" style="flex: 1;">
            <h3 class="text-white m-0">@(Model?.TeamA?.Name ?? "TBD")</h3>
        </div>
        
        <div class="text-center px-4">
            <h1 class="m-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem;">
                <span class="text-val-red">@(Model?.ScoreA ?? 0)</span>
                <span class="text-secondary mx-2">-</span>
                <span class="text-val-red">@(Model?.ScoreB ?? 0)</span>
            </h1>
        </div>
        
        <div class="text-start" style="flex: 1;">
            <h3 class="text-white m-0">@(Model?.TeamB?.Name ?? "TBD")</h3>
        </div>
    </div>

    <div class="row text-center mt-4 p-3" style="background-color: #111111; border-radius: 8px;">
        <div class="col-4 border-end border-secondary">
            <label class="text-white fw-bold d-block mb-1 text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">WINNER</label>
            <h5 class="text-white m-0 fs-5">@(Model?.Winner?.Name ?? "TBD")</h5>
        </div>
        <div class="col-4 border-end border-secondary">
            <label class="text-white fw-bold d-block mb-1 text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">DATE & TIME</label>
            <h5 class="text-white m-0 fs-5">@(Model?.ScheduledAt?.ToString("MM/dd/yyyy HH:mm") ?? "TBD")</h5>
        </div>
        <div class="col-4">
            <label class="text-white fw-bold d-block mb-1 text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">FORMAT</label>
            <h5 class="text-white m-0 fs-5">@(Model?.MatchType ?? "TBD")</h5>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-action="Edit" asp-route-id="@Model?.MatchId" class="btn btn-primary" style="font-size: 1.1rem;">EDIT MATCH DATA</a>
    </div>
</div>