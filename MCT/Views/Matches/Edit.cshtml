@model MCT.Models.Match
@{
    ViewData["Title"] = "EDIT MATCH";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">EDIT MATCH DATA</h3>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="MatchId" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TeamAId" class="form-label">TEAM A</label>
                <select asp-for="TeamAId" class="form-select" asp-items="ViewBag.TeamA"></select>
                <span asp-validation-for="TeamAId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TeamBId" class="form-label">TEAM B</label>
                <select asp-for="TeamBId" class="form-select" asp-items="ViewBag.TeamB"></select>
                <span asp-validation-for="TeamBId" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ScoreA" class="form-label">SCORE A</label>
                <input asp-for="ScoreA" class="form-control" type="number" />
                <span asp-validation-for="ScoreA" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ScoreB" class="form-label">SCORE B</label>
                <input asp-for="ScoreB" class="form-control" type="number" />
                <span asp-validation-for="ScoreB" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="TournamentId" class="form-label">EVENT</label>
            <select asp-for="TournamentId" class="form-select" asp-items="ViewBag.Tournament"></select>
            <span asp-validation-for="TournamentId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MatchType" class="form-label">FORMAT</label>
            <select asp-for="MatchType" class="form-select" asp-items="ViewBag.MatchType"></select>
            <span asp-validation-for="MatchType" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ScheduledAt" class="form-label">DATE & TIME</label>
            <input asp-for="ScheduledAt" class="form-control" type="datetime-local" />
            <span asp-validation-for="ScheduledAt" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 mt-2">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">SAVE CHANGES</button>
        </div>
    </form>
</div>