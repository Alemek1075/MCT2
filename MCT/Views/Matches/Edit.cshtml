@model MCT.Models.Match

@{
    ViewData["Title"] = "Enter Match Score";
}

<h1>Enter Score</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MatchId" />

            <div class="form-group mb-3">
                <label class="control-label fw-bold">@Model.TeamA?.Name Score</label>
                <input asp-for="ScoreA" type="number" min="0" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">@Model.TeamB?.Name Score</label>
                <input asp-for="ScoreB" type="number" min="0" class="form-control" required />
            </div>

            <div class="form-group">
                <input type="submit" value="Save Score" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>