@model MCT.Models.Match
@{
    ViewData["Title"] = "UPDATE SCORE";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">UPDATE MATCH SCORE</h3>

    @if (Model.TeamAId == null || Model.TeamBId == null)
    {
        <div class="alert bg-val-dark-red text-white font-monospace border border-danger p-3 mb-4 text-center">
            [ACCESS_DENIED] TEAMS ARE NOT YET DETERMINED. WAITING FOR PREVIOUS ROUNDS TO FINISH.
        </div>
    }

    <form asp-action="Edit">
        <input type="hidden" asp-for="MatchId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold bg-dark p-2 border border-danger rounded"></div>

        <div class="val-card p-5 text-center mb-4">
            <p class="text-muted mb-1 form-label">TOURNAMENT</p>
            <h4 class="text-white mb-4">@(Model.Tournament?.Description ?? "TBD")</h4>
            
            <div class="d-flex justify-content-center align-items-center gap-4 mt-5">
                <div class="text-end" style="flex: 1;">
                    <h2 class="text-white m-0 mb-3" style="font-size: 2.5rem;">@(Model.TeamA?.ShortCode ?? "TBD")</h2>
                    <input asp-for="ScoreA" class="form-control text-center fs-2 fw-bold" style="height: 60px;"
                           disabled="@(Model.TeamAId == null || Model.TeamBId == null ? "disabled" : null)" />
                </div>
                
                <div class="px-3">
                    <h3 class="text-secondary m-0">VS</h3>
                </div>
                
                <div class="text-start" style="flex: 1;">
                    <h2 class="text-white m-0 mb-3" style="font-size: 2.5rem;">@(Model.TeamB?.ShortCode ?? "TBD")</h2>
                    <input asp-for="ScoreB" class="form-control text-center fs-2 fw-bold" style="height: 60px;"
                           disabled="@(Model.TeamAId == null || Model.TeamBId == null ? "disabled" : null)" />
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary"
                    disabled="@(Model.TeamAId == null || Model.TeamBId == null ? "disabled" : null)">
                SAVE SCORE
            </button>
        </div>
    </form>
</div>