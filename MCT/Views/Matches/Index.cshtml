@model IEnumerable<MCT.Models.Match>
@{
    ViewData["Title"] = "MATCHES";
}

<div class="d-flex justify-content-between align-items-end mb-3 mt-3">
    <h2 class="mb-0 text-white">MATCHES</h2>
    <a asp-action="Create" class="btn-outline-val">CREATE NEW</a>
</div>

<div class="page-container mt-0 p-4">
    <table class="table table-dark table-borderless table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th class="text-white">TEAM A</th>
                <th class="text-center text-white">SCORE</th>
                <th class="text-white">TEAM B</th>
                <th class="text-white">SCHEDULED</th>
                <th class="text-white">TOURNAMENT</th>
                <th class="text-end text-white">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold fs-5 text-white">@(item.TeamA?.Name ?? "TBD")</td>
                    <td class="text-center text-val-red fw-bold fs-5" style="font-family: 'Bebas Neue', sans-serif;">
                        @(item.ScoreA ?? 0) - @(item.ScoreB ?? 0)
                    </td>
                    <td class="fw-bold fs-5 text-white">@(item.TeamB?.Name ?? "TBD")</td>
                    <td class="text-white fs-6">@(item.ScheduledAt?.ToString("MM/dd/yyyy HH:mm") ?? "TBD")</td>
                    <td class="text-white fs-6">@(item.Tournament?.Description ?? "TBD")</td>
                    <td class="text-end action-links">
                        <a asp-action="Edit" asp-route-id="@item.MatchId">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.MatchId">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.MatchId" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>