@model IEnumerable<MCT.Models.Match>
@{
    ViewData["Title"] = "MATCHES";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">MATCHES</h3>
    </div>

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0 text-center">
            <thead class="text-muted border-bottom border-secondary" style="font-size: 0.85rem;">
                <tr>
                    <th class="fw-normal text-start">EVENT</th>
                    <th class="fw-normal text-end">TEAM A</th>
                    <th class="fw-normal">SCORE</th>
                    <th class="fw-normal text-start">TEAM B</th>
                    <th class="fw-normal">DATE</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-start text-white">@(item.Tournament?.Description ?? "TBD")</td>
                        <td class="text-end fw-bold fs-5 text-white">@(item.TeamA?.ShortCode ?? "TBD")</td>
                        <td class="font-monospace fs-5 text-val-red fw-bold px-3">
                            @(item.ScoreA ?? 0) - @(item.ScoreB ?? 0)
                        </td>
                        <td class="text-start fw-bold fs-5 text-white">@(item.TeamB?.ShortCode ?? "TBD")</td>
                        <td class="font-monospace text-muted">
                            @(item.ScheduledAt?.ToString("MM/dd/yy HH:mm") ?? "TBA")
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.MatchId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.MatchId" class="btn btn-primary btn-action-sm">EDIT</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>