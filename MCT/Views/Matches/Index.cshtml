@model IEnumerable<MCT.Models.Match>

@{
    ViewData["Title"] = "Matches";
}

<h1>Matches</h1>
<table class="table">
    <thead>
        <tr>
            <th>Tournament</th>
            <th>Team A</th>
            <th>Team B</th>
            <th>Score</th>
            <th>Scheduled At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tournament?.Description</td>
                <td>@item.TeamA?.Name</td>
                <td>@item.TeamB?.Name</td>
                <td>@item.ScoreA : @item.ScoreB</td>
                <td>@(item.ScheduledAt?.ToString("g") ?? "-")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MatchId" class="btn btn-sm btn-warning">Enter Score</a>
                    <a asp-action="Details" asp-route-id="@item.MatchId" class="btn btn-sm btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>