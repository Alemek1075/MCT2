@model IEnumerable<MCT.Models.Match>
@{
    ViewData["Title"] = "MATCHES";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">MATCHES MANAGEMENT</h3>
    </div>

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="border-bottom border-secondary text-muted">
                <tr>
                    <th class="fw-normal" style="letter-spacing: 1px;">TOURNAMENT</th>
                    <th class="fw-normal text-end" style="letter-spacing: 1px; width: 25%;">TEAM A</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">SCORE</th>
                    <th class="fw-normal text-start" style="letter-spacing: 1px; width: 25%;">TEAM B</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">DATE</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-muted">@item.Tournament?.Description</td>
                        <td class="text-end text-white fw-bold fs-5">@(item.TeamA?.Name ?? "TBD")</td>
                        <td class="text-center font-monospace fs-4 text-val-orange">@(item.ScoreA ?? 0) <span class="text-muted fs-5">-</span> @(item.ScoreB ?? 0)</td>
                        <td class="text-start text-white fw-bold fs-5">@(item.TeamB?.Name ?? "TBD")</td>
                        <td class="text-center text-nowrap">@(item.ScheduledAt?.ToString("MM/dd HH:mm") ?? "-")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.MatchId" class="btn btn-sm btn-primary" style="padding: 4px 10px; font-size: 0.9rem;">SCORE</a>
                                <a asp-action="Details" asp-route-id="@item.MatchId" class="btn btn-sm btn-outline-val" style="padding: 4px 10px; font-size: 0.9rem;">DETAILS</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>