@model MCT.Models.Player
@{
    ViewData["Title"] = "REMOVE PLAYER";
}

<div class="page-container mx-auto" style="max-width: 500px;">
    <h3 class="text-danger mb-4 border-bottom border-secondary pb-2">REMOVE PLAYER ASSIGNMENT</h3>

    <div class="val-card p-4 text-center mb-4 border-danger">
        <h4 class="text-white mb-4">Are you sure you want to remove this player?</h4>
        <h1 class="text-val-orange m-0">@Model.User?.Username</h1>
        <p class="text-muted mt-2 mb-0">TEAM: <span class="text-white">@Model.Team?.Name</span></p>
    </div>

    <form asp-action="Delete" class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
        <input type="hidden" asp-for="PlayerId" />
        <a asp-action="Index" class="btn-outline-val">CANCEL</a>
        <button type="submit" class="btn btn-danger-val">CONFIRM REMOVE</button>
    </form>
</div>