@model MCT.Models.Player
@{
    ViewData["Title"] = "PLAYER DETAILS";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">PLAYER PROFILE</h3>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.PlayerId" class="btn btn-primary btn-action-sm">EDIT</a>
            <a asp-action="Index" class="btn-outline-val btn-action-sm">BACK</a>
        </div>
    </div>

    <div class="val-card p-5 text-center">
        <h1 class="text-white m-0" style="font-size: 3.5rem;">@Model.User?.Username</h1>
        <h5 class="text-muted mt-2 font-monospace">@Model.User?.Email</h5>
        
        <div class="mt-5 pt-4 border-top border-secondary row">
            <div class="col-12">
                <p class="text-muted mb-1 form-label">CURRENT TEAM</p>
                <h3 class="text-white">@(Model.Team?.Name ?? "FREE AGENT") <span class="text-val-orange font-monospace fs-4">[@(Model.Team?.ShortCode ?? "N/A")]</span></h3>
            </div>
        </div>
    </div>
</div>