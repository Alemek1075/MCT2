@model MCT.Models.Player
@{
    ViewData["Title"] = "PLAYER DETAILS";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-val-red">PLAYER DETAILS</h2>
        <a asp-action="Index" class="btn-outline-val">BACK TO LIST</a>
    </div>

    <div class="text-center mb-5 mt-4">
        <h1 class="display-4 text-white fw-bold mb-0">@(Model.User?.Username ?? "TBD")</h1>
        
        <h3 class="text-val-orange mt-2" style="font-family: 'Bebas Neue', sans-serif;">
            TEAM //
            @if (Model.TeamId.HasValue)
            {
                <a asp-controller="Teams" asp-action="Details" asp-route-id="@Model.TeamId" class="text-white text-decoration-none border-bottom border-secondary pb-1 ms-1 hover-val-red">
                    @(Model.Team?.Name ?? "UNKNOWN")
                </a>
            }
            else
            {
                <span class="text-white ms-1">NONE</span>
            }
        </h3>
    </div>

    <div class="text-center mt-5">
        <a asp-action="Edit" asp-route-id="@Model?.PlayerId" class="btn btn-primary btn-lg w-100">EDIT PLAYER DATA</a>
    </div>
</div>