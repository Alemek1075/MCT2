@model MCT.Models.Player
@{
    ViewData["Title"] = "EDIT PLAYER";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">EDIT PLAYER DATA</h3>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="PlayerId" />

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">USER (ACCOUNT)</label>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.User"></select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="TeamId" class="form-label">TEAM</label>
            <select asp-for="TeamId" class="form-select" asp-items="ViewBag.Team"></select>
            <span asp-validation-for="TeamId" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 mt-2">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">SAVE CHANGES</button>
        </div>
    </form>
</div>