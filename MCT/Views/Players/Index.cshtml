@model IEnumerable<MCT.Models.Player>
@{
    ViewData["Title"] = "PLAYERS";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">PLAYERS ROSTER</h3>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">ASSIGN PLAYER</a>
        }
    </div>

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="text-muted border-bottom border-secondary" style="font-size: 0.85rem;">
                <tr>
                    <th class="fw-normal">PLAYER (USERNAME)</th>
                    <th class="fw-normal">TEAM</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Player"))
                    {
                        <th class="fw-normal">ACCOUNT EMAIL</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-white fw-bold fs-5">@(item.User?.Username ?? "Unknown")</td>
                        <td>
                            @if (item.Team != null)
                            {
                                <span class="badge border border-secondary text-white" style="background-color: #1a1e21; letter-spacing: 1px;">@item.Team.Name</span>
                            }
                            else
                            {
                                <span class="text-muted font-monospace">FREE AGENT</span>
                            }
                        </td>
                
                        @if (User.IsInRole("Admin") || User.IsInRole("Player"))
                        {
                            <td class="text-muted font-monospace">@(item.User?.Email ?? "N/A")</td>
                        }
                
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.PlayerId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.PlayerId" class="btn btn-primary btn-action-sm">EDIT</a>
                                    <form asp-action="Delete" asp-route-id="@item.PlayerId" method="post" class="m-0 p-0 d-inline-flex">
                                        <button type="submit" class="btn btn-danger-val btn-action-sm" onclick="return confirm('Delete player?');">DELETE</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>