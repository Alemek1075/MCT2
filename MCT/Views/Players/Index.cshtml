@model IEnumerable<MCT.Models.Player>
@{
    ViewData["Title"] = "PLAYERS";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">PLAYER ASSIGNMENTS</h3>
        <a asp-action="Create" class="btn btn-primary">ASSIGN PLAYER</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger font-monospace border border-danger bg-dark text-danger fw-bold mb-4 px-3 py-2">
            [ACCESS_DENIED] @TempData["ErrorMessage"]
        </div>
    }

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="text-muted border-bottom border-secondary" style="font-size: 0.85rem;">
                <tr>
                    <th class="fw-normal" style="letter-spacing: 1px;">PLAYER NAME</th>
                    <th class="fw-normal" style="letter-spacing: 1px;">TEAM</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">TAG</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-white fw-bold fs-5">@item.User?.Username</td>
                        <td class="text-white">@item.Team?.Name</td>
                        <td class="text-center"><span class="badge bg-dark border border-secondary text-val-orange font-monospace">@item.Team?.ShortCode</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.PlayerId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                <a asp-action="Edit" asp-route-id="@item.PlayerId" class="btn btn-primary btn-action-sm">EDIT</a>
                                <form asp-action="Delete" asp-route-id="@item.PlayerId" method="post" class="m-0 p-0 d-inline-flex">
                                    <button type="submit" class="btn btn-danger-val btn-action-sm" onclick="return confirm('Remove player assignment?');">REMOVE</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>