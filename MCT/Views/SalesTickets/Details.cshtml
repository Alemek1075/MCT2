@model Dictionary<DateTime, int>
@{
    ViewData["Title"] = "SALES DETAILS";
    var tournament = ViewBag.Tournament as MCT.Models.Tournament;
    
    // Розрахунок максимального значення для осі Y
    int maxSales = Model.Values.Any() ? Model.Values.Max() : 0;
    int chartMax = maxSales > 0 ? (int)Math.Ceiling(maxSales * 1.2) : 10;
    if (chartMax % 2 != 0) chartMax++; // Щоб половина осі Y була цілим числом
}

<style>
    .sales-bar {
        width: 18px !important;
    }

    .sales-date-label {
        position: absolute;
        bottom: -35px;
        left: 50%;
        transform: translateX(-50%) rotate(-45deg);
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.85rem;
        color: #a9b4af;
        white-space: nowrap;
    }

    .sales-chart-wrapper {
        height: 400px;
        margin-top: 20px;
        margin-bottom: 40px;
    }
</style>

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <div>
            <h3 class="text-val-red m-0">DAILY SALES CHART</h3>
            <span class="text-muted text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">@(tournament?.Description)</span>
        </div>
        <a asp-action="Index" class="btn-outline-val btn-sm">BACK TO LIST</a>
    </div>

    <div class="val-card p-4">
        <h4 class="text-white mb-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 1px;">TICKETS SOLD (PRE-TOURNAMENT 30 DAYS)</h4>
        
        <div class="sales-chart-wrapper d-flex flex-column">
            <div class="chart-area" style="flex-grow: 1; margin-left: 30px; border-left: 1px solid #555; border-bottom: 1px solid #555; position: relative;">
                
                <div class="y-axis" style="position: absolute; left: -40px; top: 0; height: 100%; display: flex; flex-direction: column-reverse; justify-content: space-between; font-size: 0.85rem; color: #a9b4af; text-align: right; width: 30px; padding-bottom: 0;">
                    <span>0</span>
                    <span>@(chartMax / 2)</span>
                    <span>@chartMax</span>
                </div>

                <div class="chart-team-bars" style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; height: 100%; padding: 0 10px;">
                    @foreach (var day in Model.OrderBy(k => k.Key))
                    {
                        double percentage = chartMax > 0 ? ((double)day.Value / chartMax) * 100 : 0;
                        string labelText = day.Value > 0 ? $"+{day.Value}" : "0";

                        <div class="team-bar-group" style="height: 100%; width: 100%; position: relative;">
                            <div class="bar-container" style="height: 100%; display: flex; align-items: flex-end; justify-content: center;">
                                <div class="bar won sales-bar" style="height: @(percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%;" data-rounds="@labelText"></div>
                            </div>
                            <span class="sales-date-label">@day.Key.ToString("MM/dd")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>