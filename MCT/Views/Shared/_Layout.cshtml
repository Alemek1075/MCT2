<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCT ESPORTS</title>
    
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top" style="z-index: 1050; background-color: #111111;">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark box-shadow py-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/favicon.png" alt="MCT Logo" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" />
                    <span>MCT ESPORTS</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4 gap-3">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Tournaments" asp-action="Index">EVENTS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Matches" asp-action="Index">MATCHES</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index">LEADERBOARD</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Teams" asp-action="Index">TEAMS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Players" asp-action="Index">PLAYERS</a></li>
                        
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Tickets" asp-action="Index">TICKETS</a></li>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Users" asp-action="Index">USERS</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="SalesTickets" asp-action="Index">SALES</a></li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-4">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-dark dropdown-toggle text-white border-0 font-monospace fs-6" type="button" data-bs-toggle="dropdown" style="background-color: transparent;">
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" style="background-color: #1f2326; border: 1px solid #333;">
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item text-white font-monospace hover-val-red" style="background-color: transparent;">LOG OUT</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="#" class="text-secondary text-decoration-none fw-bold" style="letter-spacing: 1px;" data-bs-toggle="modal" data-bs-target="#signInModal">SIGN IN</a>
                            <a href="#" class="btn btn-danger-val text-white fw-bold px-4" data-bs-toggle="modal" data-bs-target="#logInModal">LOG IN</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="main-content-wrapper">
        <div class="container mt-4">
            <main role="main" class="pb-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="valConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #1f2326; border: 2px solid #ff4655; border-radius: 4px; box-shadow: 0 0 30px rgba(255, 70, 85, 0.3);">
                <div class="modal-header border-bottom border-secondary" style="background-color: #111;">
                    <h5 class="modal-title text-val-red m-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 1px;">SYSTEM CONFIRMATION</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-5 text-center">
                    <p id="valConfirmMessage" class="text-white fs-5 mb-0 font-monospace">Are you sure?</p>
                </div>
                <div class="modal-footer border-top border-secondary justify-content-center gap-3 p-3">
                    <button type="button" class="btn btn-outline-val m-0" data-bs-dismiss="modal" style="width: 150px;">CANCEL</button>
                    <button type="button" class="btn btn-danger-val m-0" id="valConfirmBtn" style="width: 150px;">CONFIRM</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="signInModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content val-card border-secondary">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title text-val-red m-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 1px;">CREATE ACCOUNT</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Auth" asp-action="Register" method="post">
                    <div class="modal-body p-4">
                        @if (TempData["AuthError"]?.ToString() == "register" && TempData["AuthErrorMessage"] != null)
                        {
                            <div class="alert alert-danger p-2 mb-3 font-monospace" style="font-size: 0.85rem;">
                                @TempData["AuthErrorMessage"]
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label text-muted text-uppercase" style="font-size: 0.85rem;">Username</label>
                            <input type="text" name="username" class="form-control" value="@TempData["signtempdataname"]" required minlength="3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted text-uppercase" style="font-size: 0.85rem;">Email</label>
                            <input type="email" name="email" class="form-control" value="@TempData["signtempdataemail"]" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted text-uppercase" style="font-size: 0.85rem;">Password</label>
                            <input type="password" name="password" class="form-control" value="@TempData["signtempdatapass"]" required minlength="6" />
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="submit" class="btn btn-primary">SIGN IN</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="logInModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content val-card border-secondary">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title text-val-red m-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 1px;">SYSTEM LOGIN</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="modal-body p-4">
                        @if (TempData["AuthError"]?.ToString() == "login" && TempData["AuthErrorMessage"] != null)
                        {
                            <div class="alert alert-danger p-2 mb-3 font-monospace" style="font-size: 0.85rem;">
                                @TempData["AuthErrorMessage"]
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label text-muted text-uppercase" style="font-size: 0.85rem;">Username or Email</label>
                            <input type="text" name="loginIdentifier" class="form-control" value="@TempData["logtempdata1"]" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted text-uppercase" style="font-size: 0.85rem;">Password</label>
                            <input type="password" name="password" class="form-control" value="@TempData["logtempdatapass"]" required />
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="submit" class="btn btn-danger-val">LOG IN</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["AuthError"] != null)
    {
        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    var errorType = '@TempData["AuthError"]';
                    if (errorType === 'login') {
                        var loginModal = new bootstrap.Modal(document.getElementById('logInModal'));
                        loginModal.show();
                    } else if (errorType === 'register') {
                        var registerModal = new bootstrap.Modal(document.getElementById('signInModal'));
                        registerModal.show();
                    }
                });
        </script>
    }

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                var signInModal = document.getElementById('signInModal');
                var logInModal = document.getElementById('logInModal');

                signInModal.addEventListener('hidden.bs.modal', function () {
                    var inputs = this.querySelectorAll('input');
                    inputs.forEach(function(input) { input.value = ''; });
                });

                logInModal.addEventListener('hidden.bs.modal', function () {
                    var inputs = this.querySelectorAll('input');
                    inputs.forEach(function(input) { input.value = ''; });
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>