<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCT ESPORTS</title>
    
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top" style="z-index: 1050; background-color: #111111;">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark box-shadow py-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/favicon.png" alt="MCT Logo" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" />
                    <span>MCT ESPORTS</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4 gap-3">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">HOME</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Tournaments" asp-action="Index">EVENTS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Matches" asp-action="Index">MATCHES</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Teams" asp-action="Index">TEAMS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index">LEADERBOARD</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Players" asp-action="Index">PLAYERS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Users" asp-action="Index">USERS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Tickets" asp-action="Index">TICKETS</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="SalesTickets" asp-action="Index">SALES</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="main-content-wrapper">
        <div class="container mt-4">
            <main role="main" class="pb-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="valConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #1f2326; border: 2px solid #ff4655; border-radius: 4px; box-shadow: 0 0 30px rgba(255, 70, 85, 0.3);">
                <div class="modal-header border-bottom border-secondary" style="background-color: #111;">
                    <h5 class="modal-title text-val-red m-0" style="font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 1px;">SYSTEM CONFIRMATION</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-5 text-center">
                    <p id="valConfirmMessage" class="text-white fs-5 mb-0 font-monospace">Are you sure?</p>
                </div>
                <div class="modal-footer border-top border-secondary justify-content-center gap-3 p-3">
                    <button type="button" class="btn btn-outline-val m-0" data-bs-dismiss="modal" style="width: 150px;">CANCEL</button>
                    <button type="button" class="btn btn-danger-val m-0" id="valConfirmBtn" style="width: 150px;">CONFIRM</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>