@model MCT.Models.Team
@{
    ViewData["Title"] = "CREATE TEAM";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h2 class="mb-4 text-val-red">CREATE TEAM</h2>
    
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="mb-3">
            <label asp-for="Name" class="control-label">TEAM NAME</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ShortCode" class="control-label">TAG (SHORT CODE)</label>
                <input asp-for="ShortCode" class="form-control" />
                <span asp-validation-for="ShortCode" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Region" class="control-label">REGION</label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="MemberCount" class="control-label">MEMBER COUNT</label>
            <input asp-for="MemberCount" class="form-control" />
            <span asp-validation-for="MemberCount" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <a asp-action="Index" class="btn-outline-val border-0 px-0">CANCEL</a>
            <input type="submit" value="SAVE TEAM" class="btn btn-primary" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}