@model MCT.Models.Team
@{
    ViewData["Title"] = "CREATE TEAM";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">CREATE NEW TEAM</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">TEAM NAME</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ShortCode" class="form-label">TAG (SHORT CODE)</label>
            <input asp-for="ShortCode" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Region" class="form-label">REGION</label>
            <input asp-for="Region" class="form-control" />
        </div>

        <div class="mb-4">
            <label asp-for="MemberCount" class="form-label">MEMBERS</label>
            <input asp-for="MemberCount" class="form-control" type="number" />
        </div>

        <div class="d-flex justify-content-between pt-3">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">CREATE TEAM</button>
        </div>
    </form>
</div>