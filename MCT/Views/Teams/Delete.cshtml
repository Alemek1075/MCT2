@model MCT.Models.Team
@{
    ViewData["Title"] = "DELETE TEAM";
}

<div class="page-container mx-auto" style="max-width: 500px;">
    <h3 class="text-danger mb-4 border-bottom border-secondary pb-2">DELETE TEAM</h3>

    <div class="val-card p-4 text-center mb-4">
        <h4 class="text-white">Are you sure you want to delete this team?</h4>
        <h1 class="text-val-orange mt-3" style="font-size: 3rem;">@Model.Name</h1>
    </div>

    <form asp-action="Delete" class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
        <input type="hidden" asp-for="TeamId" />
        <a asp-action="Index" class="btn-outline-val">CANCEL</a>
        <button type="submit" class="btn btn-danger-val">CONFIRM DELETE</button>
    </form>
</div>