@model MCT.Models.Team
@{
    ViewData["Title"] = "DELETE TEAM";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">DELETE TEAM CONFIRMATION</h3>
    
    <div class="alert alert-danger bg-dark border-danger text-white mb-4 fs-6 fw-bold">
        Are you sure you want to delete this team?
    </div>

    <div class="p-4 mb-4" style="background-color: #111111; border-radius: 8px; border-left: 4px solid #ff4655;">
        <label class="form-label text-muted d-block mb-1">TEAM NAME</label>
        <h3 class="text-white fw-bold mb-3">@Model.Name</h3>
        
        <div class="row">
            <div class="col-6">
                <label class="form-label text-muted d-block mb-1">SHORT CODE</label>
                <p class="text-val-orange fs-5 fw-bold mb-0">@Model.ShortCode</p>
            </div>
            <div class="col-6">
                <label class="form-label text-muted d-block mb-1">REGION</label>
                <p class="text-white fs-5 mb-0">@Model.Region</p>
            </div>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="TeamId" />
        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-danger-val">PERMANENTLY DELETE</button>
        </div>
    </form>
</div>