@model MCT.Models.Team
@{
    ViewData["Title"] = "TEAM DETAILS";
}

<div class="page-container mx-auto" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">TEAM PROFILE</h3>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.TeamId" class="btn btn-primary btn-action-sm">EDIT TEAM</a>
            }
            <a asp-action="Index" class="btn-outline-val btn-action-sm">BACK</a>
        </div>
    </div>

    <div class="val-card p-5 text-center mb-4">
        <h1 class="text-white m-0 text-uppercase" style="font-size: 3.5rem; letter-spacing: 2px;">@Model.Name</h1>
        <h4 class="text-val-orange mt-2 mb-4 font-monospace">[@Model.ShortCode]</h4>
        
        <div class="d-flex justify-content-center border-top border-secondary pt-4 mt-4">
            <div class="px-5 border-end border-secondary">
                <p class="text-muted mb-1 form-label">REGION</p>
                <h4 class="text-white m-0">@Model.Region</h4>
            </div>
            <div class="px-5">
                <p class="text-muted mb-1 form-label">ACTIVE PLAYERS</p>
                <h4 class="text-white m-0">@(Model.Players?.Count ?? 0)</h4>
            </div>
        </div>
    </div>

    <h5 class="text-white mb-3 mt-5">ACTIVE ROSTER</h5>
    <div class="val-card p-4">
        @if (Model.Players != null && Model.Players.Any())
        {
            <table class="table table-dark table-borderless align-middle mb-0">
                <thead class="text-muted border-bottom border-secondary" style="font-size: 0.85rem;">
                    <tr>
                        <th class="fw-normal">PLAYER (USERNAME)</th>
                        @if (User.IsInRole("Admin") || User.IsInRole("Player"))
                        {
                            <th class="fw-normal">ACCOUNT EMAIL</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model.Players)
                    {
                        <tr class="border-bottom border-secondary" style="height: 60px;">
                            <td class="text-white fw-bold fs-5">@(player.User?.Username ?? "Unknown")</td>
                
                            @if (User.IsInRole("Admin") || User.IsInRole("Player"))
                            {
                                <td class="text-muted font-monospace">@(player.User?.Email ?? "N/A")</td>
                            }
                
                            <td class="text-end">
                                <a asp-controller="Players" asp-action="Details" asp-route-id="@player.PlayerId" class="btn btn-outline-val btn-action-sm">VIEW PROFILE</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-muted font-monospace my-3">NO PLAYERS ASSIGNED TO THIS TEAM</div>
        }
    </div>
</div>