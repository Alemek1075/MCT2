@model MCT.Models.Team
@{
    ViewData["Title"] = "TEAM DETAILS";
}

<div class="page-container mx-auto" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">TEAM PROFILE</h3>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.TeamId" class="btn btn-primary btn-action-sm">EDIT TEAM</a>
            <a asp-action="Index" class="btn-outline-val btn-action-sm">BACK</a>
        </div>
    </div>

    <div class="val-card p-5 text-center mb-5">
        <h1 class="text-white mb-2" style="font-size: 3.5rem;">@Model.Name</h1>
        <h3 class="text-val-orange mb-4 font-monospace">[@Model.ShortCode]</h3>
        
        <div class="row border-top border-secondary pt-4 mt-2">
            <div class="col-6 border-end border-secondary">
                <p class="text-muted mb-1 form-label">REGION</p>
                <h4 class="text-white">@Model.Region</h4>
            </div>
            <div class="col-6">
                <p class="text-muted mb-1 form-label">ACTIVE PLAYERS</p>
                <h4 class="text-white font-monospace">@Model.ActualMemberCount</h4>
            </div>
        </div>
    </div>

    <h4 class="text-white mb-3" style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px;">ACTIVE ROSTER</h4>
    <div class="val-card p-0 overflow-hidden mb-4">
        <table class="table table-dark table-borderless m-0 align-middle">
            <thead>
                <tr class="text-muted border-bottom border-secondary" style="font-size: 0.8rem; background-color: transparent;">
                    <th class="ps-4">PLAYER NAME</th>
                    <th>ACCOUNT EMAIL</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Players != null && Model.Players.Any())
                {
                    foreach (var p in Model.Players)
                    {
                        <tr class="border-bottom border-secondary" style="height: 55px; background-color: transparent;">
                            <td class="ps-4 text-white fw-bold fs-5">@p.User?.Username</td>
                            <td class="text-muted">@p.User?.Email</td>
                            <td class="text-end pe-4">
                                <a asp-controller="Players" asp-action="Details" asp-route-id="@p.PlayerId" class="btn btn-outline-val btn-action-sm" style="font-size: 0.8rem;">VIEW PROFILE</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center p-4 text-muted font-monospace">NO PLAYERS ASSIGNED TO THIS TEAM YET.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>