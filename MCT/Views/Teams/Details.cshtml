@model MCT.Models.Team

@{
    ViewData["Title"] = "Team Details";
}

<h1>Details</h1>

<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        
        <dt class="col-sm-2">Short Code</dt>
        <dd class="col-sm-10">@Model.ShortCode</dd>
        
        <dt class="col-sm-2">Region</dt>
        <dd class="col-sm-10">@Model.Region</dd>

        <dt class="col-sm-2">Players Count</dt>
        <dd class="col-sm-10">@Model.ActualMemberCount</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.TeamId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>