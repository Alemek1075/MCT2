@model MCT.Models.Team
@{
    ViewData["Title"] = "EDIT TEAM";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">EDIT TEAM DATA</h3>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="TeamId" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">TEAM NAME</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ShortCode" class="form-label">TAG (SHORT CODE)</label>
            <input asp-for="ShortCode" class="form-control" />
            <span asp-validation-for="ShortCode" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Region" class="form-label">REGION</label>
            <input asp-for="Region" class="form-control" />
            <span asp-validation-for="Region" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">SAVE CHANGES</button>
        </div>
    </form>
</div>