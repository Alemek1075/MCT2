@model IEnumerable<MCT.Models.Team>

@{
    ViewData["Title"] = "Teams";
}

<h1>Teams</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Create Team</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Short Code</th>
            <th>Region</th>
            <th>Players Count</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ShortCode</td>
                    <td>@item.Region</td>
                    <td>@(item.Players != null ? item.Players.Count : 0)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.TeamId">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>