@model IEnumerable<MCT.Models.Team>
@{
    ViewData["Title"] = "TEAMS";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">TEAMS MANAGEMENT</h3>
        <a asp-action="Create" class="btn btn-primary">CREATE TEAM</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger font-monospace border border-danger bg-dark text-danger fw-bold mb-4">
            [ERROR] @TempData["ErrorMessage"]
        </div>
    }

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="border-bottom border-secondary text-muted">
                <tr>
                    <th class="fw-normal" style="letter-spacing: 1px;">TEAM NAME</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">SHORT CODE</th>
                    <th class="fw-normal" style="letter-spacing: 1px;">REGION</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">PLAYERS</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-white fw-bold fs-5">@item.Name</td>
                        <td class="text-center text-val-orange fw-bold fs-5 font-monospace">@item.ShortCode</td>
                        <td>@item.Region</td>
                        <td class="text-center font-monospace fs-5">@item.ActualMemberCount</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.TeamId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                <a asp-action="Edit" asp-route-id="@item.TeamId" class="btn btn-primary btn-action-sm">EDIT</a>
                                <form asp-action="Delete" asp-route-id="@item.TeamId" method="post" class="m-0 p-0 d-inline-flex">
                                    <button type="submit" class="btn btn-danger-val btn-action-sm" onclick="return confirm('Are you sure you want to delete @item.Name?');">DELETE</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>