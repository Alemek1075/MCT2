@model MCT.Models.Ticket
@{
    ViewData["Title"] = "CREATE TICKET";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h2 class="mb-4 text-val-red">CREATE TICKET</h2>
    
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="mb-3">
            <label asp-for="UserId" class="control-label">USER</label>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
                <option value="">-- SELECT USER --</option>
            </select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TournamentId" class="control-label">EVENT</label>
            <select asp-for="TournamentId" class="form-select" asp-items="ViewBag.TournamentId">
                <option value="">-- SELECT EVENT --</option>
            </select>
            <span asp-validation-for="TournamentId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PurchaseDate" class="control-label">PURCHASE DATE</label>
                <input asp-for="PurchaseDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="Status" class="control-label">STATUS</label>
                <select asp-for="Status" class="form-select" asp-items="ViewBag.Status">
                    <option value="">-- SELECT STATUS --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <a asp-action="Index" class="btn-outline-val border-0 px-0">CANCEL</a>
            <input type="submit" value="SAVE TICKET" class="btn btn-primary" />
        </div>
    </form>
</div>