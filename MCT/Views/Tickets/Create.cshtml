@model MCT.Models.Ticket
@{
    ViewData["Title"] = "CREATE TICKET";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">CREATE NEW TICKET</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">USER</label>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
        </div>

        <div class="mb-3">
            <label asp-for="TournamentId" class="form-label">EVENT</label>
            <select asp-for="TournamentId" class="form-select" asp-items="ViewBag.TournamentId"></select>
        </div>

        <div class="mb-3">
            <label asp-for="PurchaseDate" class="form-label">PURCHASE DATE</label>
            <input asp-for="PurchaseDate" class="form-control" type="datetime-local" />
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">STATUS</label>
            <select asp-for="Status" class="form-select" asp-items="ViewBag.Status"></select>
        </div>

        <div class="mb-4">
            <label asp-for="QrCode" class="form-label">QR CODE (16 DIGITS)</label>
            <input asp-for="QrCode" class="form-control font-monospace" type="text" pattern="\d{16}" minlength="16" maxlength="16" title="Exactly 16 digits required" />
            <span asp-validation-for="QrCode" class="text-danger"></span>
        </div>

        <div class="row pt-3">
            <div class="col-6"><button type="submit" class="btn btn-primary w-100">CREATE TICKET</button></div>
            <div class="col-6"><a asp-action="Index" class="btn-outline-val w-100">CANCEL</a></div>
        </div>
    </form>
</div>