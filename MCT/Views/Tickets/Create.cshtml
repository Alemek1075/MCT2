@model MCT.Models.Ticket
@{
    ViewData["Title"] = "ISSUE TICKET";
}

<div class="page-container mx-auto" style="max-width: 500px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">ISSUE NEW TICKET</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold bg-dark p-2 border border-danger" style="border-radius: 4px;"></div>

        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-end mb-1">
                <label asp-for="TournamentId" class="form-label m-0">EVENT</label>
                <span class="text-muted font-monospace" style="font-size: 0.85rem;">PRICE: <span id="VisualPrice" class="text-val-orange fw-bold fs-6">$0</span></span>
            </div>
            <select asp-for="TournamentId" id="TournamentSelect" class="form-select" asp-items="ViewBag.TournamentId"></select>
            <span asp-validation-for="TournamentId" class="text-danger fw-bold d-block mt-1"></span>
        </div>

        <div class="mb-4">
            <label asp-for="UserId" class="form-label">OWNER (USER)</label>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
        </div>

        <div class="mb-4">
            <label asp-for="PurchaseDate" class="form-label">ISSUE DATE</label>
            <input asp-for="PurchaseDate" type="date" class="form-control" required />
            <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">Can only be issued within 1 month prior to the event start.</span>
            <span asp-validation-for="PurchaseDate" class="text-danger fw-bold d-block mt-1"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">ISSUE TICKET</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const tournamentPrices = {
            @foreach (var t in ViewBag.TournamentsList)
            {
                    decimal price = t.Places > 0 ? (t.Price ?? 0) / t.Places : 0;
                    <text>@t.TournamentId : @Math.Floor(price),</text>
            }
        };
        const select = document.getElementById('TournamentSelect');
        const priceLabel = document.getElementById('VisualPrice');
        function updatePrice() {
            const id = select.value;
            priceLabel.textContent = '$' + (tournamentPrices[id] || 0);
        }
        select.addEventListener('change', updatePrice);
        updatePrice();
    </script>
}