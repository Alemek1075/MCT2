@model MCT.Models.Ticket
@{
    ViewData["Title"] = "DELETE TICKET";
}

<div class="page-container mx-auto" style="max-width: 500px;">
    <h3 class="text-danger mb-4 border-bottom border-secondary pb-2">REVOKE TICKET</h3>

    <div class="val-card p-4 text-center mb-4">
        <h4 class="text-white">Are you sure you want to revoke this ticket?</h4>
        <p class="text-muted mt-3 mb-1">OWNER</p>
        <h2 class="text-val-orange">@Model.User?.Username</h2>
        <p class="text-muted mt-3 mb-1">EVENT</p>
        <h4 class="text-white">@Model.Tournament?.Description</h4>
    </div>

    <form asp-action="Delete" class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
        <input type="hidden" asp-for="TicketId" />
        <a asp-action="Index" class="btn-outline-val">CANCEL</a>
        <button type="submit" class="btn btn-danger-val">CONFIRM REVOKE</button>
    </form>
</div>