@model MCT.Models.Ticket

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Ticket</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PurchaseDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PurchaseDate)</dd>
        
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.QrCode)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.QrCode)</dd>
        
