@model IEnumerable<MCT.Models.Ticket>
@{
    ViewData["Title"] = "TICKETS REGISTRY";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">TICKETS REGISTRY</h3>
        <a asp-action="Create" class="btn btn-primary">ISSUE TICKET</a>
    </div>

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="text-muted border-bottom border-secondary" style="font-size: 0.85rem;">
                <tr>
                    <th class="fw-normal">EVENT</th>
                    <th class="fw-normal">OWNER</th>
                    <th class="fw-normal">DATE</th>
                    <th class="fw-normal">STATUS</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string finalStatus = item.Status;
                    
                    if (finalStatus == "Valid" && item.Tournament?.EndDate.HasValue == true)
                    {
                        if (System.DateTime.UtcNow.Date > item.Tournament.EndDate.Value.Date)
                        {
                            finalStatus = "Used";
                        }
                    }

                    string statusClass = finalStatus == "Valid" ? "bg-success" : (finalStatus == "Canceled" ? "bg-danger" : "bg-secondary");

                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-white fw-bold fs-5">@(item.Tournament?.Description ?? "N/A")</td>
                        <td class="text-muted">@(item.User?.Username ?? "N/A")</td>
                        <td class="font-monospace">@(item.PurchaseDate?.ToString("MM/dd/yyyy") ?? "TBA")</td>
                        <td><span class="badge @statusClass border border-secondary text-uppercase" style="letter-spacing: 1px;">@finalStatus</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.TicketId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.TicketId" class="btn btn-primary btn-action-sm">EDIT</a>
                                    <form asp-action="Delete" asp-route-id="@item.TicketId" method="post" class="m-0 p-0 d-inline-flex">
                                        <button type="submit" class="btn btn-danger-val btn-action-sm" onclick="return confirm('Delete ticket?');">DELETE</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>