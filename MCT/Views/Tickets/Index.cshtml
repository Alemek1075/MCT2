@model IEnumerable<MCT.Models.Ticket>
@{
    ViewData["Title"] = "TICKETS";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">TICKETS REGISTRY</h3>
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger font-monospace border border-danger bg-dark text-danger fw-bold mb-4 px-3 py-2" style="font-size: 0.85rem; border-radius: 4px;">
                [ACCESS_DENIED] @TempData["ErrorMessage"]
            </div>
        }
        <a asp-action="Create" class="btn btn-primary">ISSUE TICKET</a>
    </div>

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="border-bottom border-secondary text-muted">
                <tr>
                    <th class="fw-normal" style="letter-spacing: 1px;">EVENT</th>
                    <th class="fw-normal" style="letter-spacing: 1px;">OWNER</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">DATE</th>
                    <th class="fw-normal text-center" style="letter-spacing: 1px;">STATUS</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string displayStatus = item.Status == "Canceled" ? "CANCELED" :
                                          (item.Tournament?.EndDate < DateTime.UtcNow.Date ? "USED" : "VALID");
                    
                    string badgeClass = displayStatus == "CANCELED" ? "bg-danger" :
                                       (displayStatus == "USED" ? "bg-secondary" : "bg-success");

                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-white fw-bold">@item.Tournament?.Description</td>
                        <td class="text-val-orange">@item.User?.Username</td>
                        <td class="text-center font-monospace">@(item.PurchaseDate?.ToString("MM/dd/yyyy") ?? "-")</td>
                        <td class="text-center">
                            <span class="badge @badgeClass border border-secondary text-white" style="letter-spacing: 1px;">@displayStatus</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.TicketId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                <a asp-action="Edit" asp-route-id="@item.TicketId" class="btn btn-primary btn-action-sm">EDIT</a>
                                <form asp-action="Delete" asp-route-id="@item.TicketId" method="post" class="m-0 p-0 d-inline-flex">
                                    <button type="submit" class="btn btn-danger-val btn-action-sm" onclick="return confirm('Delete ticket permanently?');">DELETE</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>