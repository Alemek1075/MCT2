@model MCT.Models.Tournament

@{
    ViewData["Title"] = "Create Tournament";
}

<h1>Create Tournament</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" id="tournamentForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Name</label>
                <input asp-for="Description" class="form-control" required />
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Location" class="control-label">Location</label>
                <input asp-for="Location" class="form-control" required />
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label">Prize Pool</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Places" class="control-label">Spectator Seats (Total Places)</label>
                <input asp-for="Places" type="number" min="0" class="form-control" required />
                <span asp-validation-for="Places" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="StartDate" class="control-label">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Participating Teams</label>
                <small class="d-block text-muted mb-2">Search and click to add teams. You must select exactly 2, 4, or 8 teams.</small>
                
                <div class="position-relative">
                    <input type="text" id="teamSearchInput" class="form-control" placeholder="Type team name..." autocomplete="off" />
                    <ul id="teamSearchResults" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000; display: none; max-height: 200px; overflow-y: auto;">
                    </ul>
                </div>

                <div id="selectedTeamsBox" class="mt-3 d-flex flex-wrap gap-2">
                </div>
                
                <div id="hiddenInputs"></div>
                <span asp-validation-for="SelectedTeamIds" class="text-danger d-block mt-2"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const allTeams = [
            @if (ViewBag.Teams != null)
            {
                    foreach (var team in ViewBag.Teams)
                    {
                            <text>{ id: @team.TeamId, name: '@Html.Raw(team.Name)' },</text>
                    }
            }
        ];
        
        let selectedTeamIds = [
            @if (Model?.SelectedTeamIds != null)
            {
                    foreach (var id in Model.SelectedTeamIds)
                    {
                            <text>@id,</text>
                    }
            }
        ];

        const searchInput = document.getElementById('teamSearchInput');
        const searchResults = document.getElementById('teamSearchResults');
        const selectedBox = document.getElementById('selectedTeamsBox');
        const hiddenInputs = document.getElementById('hiddenInputs');

        document.addEventListener("DOMContentLoaded", () => {
            if (selectedTeamIds.length > 0) renderSelected();
        });

        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            searchResults.innerHTML = '';
            
            if (query.length === 0) {
                searchResults.style.display = 'none';
                return;
            }

            const filtered = allTeams.filter(t => t.name.toLowerCase().includes(query) && !selectedTeamIds.includes(t.id));
            
            if (filtered.length > 0) {
                searchResults.style.display = 'block';
                filtered.forEach(t => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.style.cursor = 'pointer';
                    li.textContent = t.name;
                    li.onclick = () => addTeam(t.id);
                    searchResults.appendChild(li);
                });
            } else {
                searchResults.style.display = 'none';
            }
        });

        document.addEventListener('click', function(e) {
            if (e.target !== searchInput && e.target !== searchResults) {
                searchResults.style.display = 'none';
            }
        });

        function addTeam(id) {
            if (!selectedTeamIds.includes(id)) {
                selectedTeamIds.push(id);
                renderSelected();
            }
            searchInput.value = '';
            searchResults.style.display = 'none';
            searchInput.focus();
        }

        function removeTeam(id) {
            selectedTeamIds = selectedTeamIds.filter(tId => tId !== id);
            renderSelected();
        }

        function renderSelected() {
            selectedBox.innerHTML = '';
            hiddenInputs.innerHTML = '';
            
            selectedTeamIds.forEach(id => {
                const team = allTeams.find(t => t.id === id);
                if(!team) return;
                
                // Візуальний бейдж
                const badge = document.createElement('span');
                badge.className = 'badge bg-primary d-flex align-items-center p-2 fs-6';
                badge.innerHTML = `${team.name} <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.5rem;" onclick="removeTeam(${id})"></button>`;
                selectedBox.appendChild(badge);

                // Прихований інпут для відправки на сервер
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'SelectedTeamIds';
                hidden.value = id;
                hiddenInputs.appendChild(hidden);
            });
        }
    </script>
}