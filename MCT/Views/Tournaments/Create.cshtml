@model MCT.Models.Tournament
@{
    ViewData["Title"] = "CREATE EVENT";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">CREATE NEW EVENT</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label text-white fw-bold text-uppercase" style="font-size: 0.85rem;">EVENT NAME</label>
            <input asp-for="Description" class="form-control" placeholder="Enter event name..." />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label text-white fw-bold text-uppercase" style="font-size: 0.85rem;">LOCATION</label>
            <input asp-for="Location" class="form-control" placeholder="City or Arena..." />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label text-white fw-bold text-uppercase" style="font-size: 0.85rem;">START DATE</label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label text-white fw-bold text-uppercase" style="font-size: 0.85rem;">END DATE</label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label text-white fw-bold text-uppercase" style="font-size: 0.85rem;">PRIZE</label>
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-val-orange">$</span>
                <input asp-for="Price" class="form-control" placeholder="0" />
            </div>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Status" class="form-label text-white fw-bold text-uppercase" style="font-size: 0.85rem;">STATUS LOGIC</label>
            <select asp-for="Status" class="form-select" asp-items="ViewBag.Status"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary flex-grow-1">CREATE EVENT</button>
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
        </div>
    </form>
</div>