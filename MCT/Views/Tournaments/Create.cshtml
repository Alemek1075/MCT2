@model MCT.Models.Tournament
@{
    ViewData["Title"] = "CREATE EVENT";
}

<div class="page-container mx-auto" style="max-width: 800px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">CREATE NEW EVENT</h3>

    <form asp-action="Create" id="tournamentForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold bg-dark p-2 border border-danger" style="border-radius: 4px;"></div>

        <div class="val-card p-4 mb-4">
            <h5 class="text-val-orange mb-4 border-bottom border-secondary pb-2" style="font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 1px;">GENERAL INFO</h5>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Description" class="form-label">EVENT NAME</label>
                    <input asp-for="Description" class="form-control" required />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label">LOCATION</label>
                    <input asp-for="Location" class="form-control" required />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label">START DATE</label>
                    <input asp-for="StartDate" type="date" class="form-control" required />
                    <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">End date auto-calculated based on teams.</span>
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Places" class="form-label">SPECTATOR SEATS</label>
                    <input asp-for="Places" type="number" min="0" class="form-control" required />
                    <span asp-validation-for="Places" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-2">
                <label asp-for="Price" class="form-label">PRIZE POOL</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-val-orange fw-bold">$</span>
                    <input asp-for="Price" type="number" step="1" min="0" class="form-control" required onkeydown="return event.key !== '.' && event.key !== ','" />
                </div>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="val-card p-4 mb-4">
            <h5 class="text-val-orange mb-3 border-bottom border-secondary pb-2" style="font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 1px;">PARTICIPATING TEAMS</h5>
            <label class="form-label text-muted text-transform-none mb-3" style="font-size: 0.85rem;">Search and click to add teams. You must select exactly 2, 4, or 8 teams.</label>
            
            <div class="position-relative mb-3">
                <input type="text" id="teamSearchInput" class="form-control border-secondary" style="background-color: #111;" placeholder="Type team name..." autocomplete="off" />
                <ul id="teamSearchResults" class="list-group position-absolute w-100 shadow-lg" style="z-index: 1000; display: none; max-height: 200px; overflow-y: auto; background-color: #1f2326; border: 1px solid #555;">
                </ul>
            </div>

            <div id="selectedTeamsBox" class="mt-3 d-flex flex-wrap gap-2 p-3 border border-secondary" style="min-height: 70px; border-radius: 4px; background-color: #111;">
                <span class="text-muted w-100 text-center mt-1" id="emptyTeamsText" style="font-size: 0.9rem;">No teams selected yet...</span>
            </div>
            
            <div id="hiddenInputs"></div>
            <span asp-validation-for="SelectedTeamIds" class="text-danger d-block mt-2 fw-bold"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">CREATE EVENT</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const allTeams = [
            @if (ViewBag.Teams != null)
            {
                    foreach (var team in ViewBag.Teams)
                    {
                            <text>{ id: @team.TeamId, name: '@Html.Raw(team.Name)' },</text>
                    }
            }
        ];
        
        let selectedTeamIds = [
            @if (Model?.SelectedTeamIds != null)
            {
                    foreach (var id in Model.SelectedTeamIds)
                    {
                            <text>@id,</text>
                    }
            }
        ];

        const searchInput = document.getElementById('teamSearchInput');
        const searchResults = document.getElementById('teamSearchResults');
        const selectedBox = document.getElementById('selectedTeamsBox');
        const hiddenInputs = document.getElementById('hiddenInputs');
        const emptyText = document.getElementById('emptyTeamsText');

        document.addEventListener("DOMContentLoaded", () => {
            renderSelected();
        });

        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            searchResults.innerHTML = '';
            
            if (query.length === 0) {
                searchResults.style.display = 'none';
                return;
            }

            const filtered = allTeams.filter(t => t.name.toLowerCase().includes(query) && !selectedTeamIds.includes(t.id));
            
            if (filtered.length > 0) {
                searchResults.style.display = 'block';
                filtered.forEach(t => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item text-white border-secondary';
                    li.style.backgroundColor = '#1f2326';
                    li.style.cursor = 'pointer';
                    li.style.transition = '0.2s';
                    li.textContent = t.name;
                    
                    li.onmouseover = function() { this.style.backgroundColor = '#ff4655'; };
                    li.onmouseout = function() { this.style.backgroundColor = '#1f2326'; };
                    
                    li.onclick = () => addTeam(t.id);
                    searchResults.appendChild(li);
                });
            } else {
                searchResults.style.display = 'none';
            }
        });

        document.addEventListener('click', function(e) {
            if (e.target !== searchInput && e.target !== searchResults) {
                searchResults.style.display = 'none';
            }
        });

        function addTeam(id) {
            if (!selectedTeamIds.includes(id)) {
                selectedTeamIds.push(id);
                renderSelected();
            }
            searchInput.value = '';
            searchResults.style.display = 'none';
            searchInput.focus();
        }

        window.removeTeam = function(id) {
            selectedTeamIds = selectedTeamIds.filter(tId => tId !== id);
            renderSelected();
        }

        function renderSelected() {
            selectedBox.innerHTML = '';
            hiddenInputs.innerHTML = '';
            
            if (selectedTeamIds.length === 0) {
                if(emptyText) selectedBox.appendChild(emptyText);
                emptyText.style.display = 'block';
                return;
            }

            selectedTeamIds.forEach(id => {
                const team = allTeams.find(t => t.id === id);
                if(!team) return;
                
                const badge = document.createElement('span');
                badge.className = 'badge d-flex align-items-center px-3 py-2 fs-6';
                badge.style.backgroundColor = '#ff4655';
                badge.innerHTML = `${team.name} <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.6rem;" onclick="removeTeam(${id})"></button>`;
                selectedBox.appendChild(badge);

                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'SelectedTeamIds';
                hidden.value = id;
                hiddenInputs.appendChild(hidden);
            });
        }
    </script>
}