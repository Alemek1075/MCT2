@model MCT.Models.Tournament
@{
    ViewData["Title"] = "DELETE EVENT";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">DELETE EVENT CONFIRMATION</h3>
    
    <div class="alert alert-danger bg-dark border-danger text-white mb-4 fs-6 fw-bold">
        Are you sure you want to delete this event?
    </div>

    <div class="p-4 mb-4" style="background-color: #111111; border-radius: 8px; border-left: 4px solid #ff4655;">
        <label class="form-label text-muted d-block mb-1">EVENT NAME</label>
        <h3 class="text-white fw-bold mb-3">@Model.Description</h3>
        
        <label class="form-label text-muted d-block mb-1">LOCATION</label>
        <p class="text-white fs-5 mb-3">@Model.Location</p>
        
        <label class="form-label text-muted d-block mb-1">PRIZE POOL</label>
        <p class="text-val-orange fs-4 fw-bold font-monospace mb-3">$@(Math.Floor(Model.Price ?? 0))</p>

        <div class="border-top border-secondary pt-3 mt-3">
            <label class="form-label text-muted d-block mb-1">DATES</label>
            <p class="text-white fs-5 m-0">@(Model.StartDate?.ToString("MM/dd/yyyy") ?? "TBD") - @(Model.EndDate?.ToString("MM/dd/yyyy") ?? "TBD")</p>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="TournamentId" />
        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-danger-val">PERMANENTLY DELETE</button>
        </div>
    </form>
</div>