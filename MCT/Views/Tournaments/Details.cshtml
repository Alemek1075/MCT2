@model MCT.Models.Tournament
@{
    ViewData["Title"] = "EVENT DETAILS";
}

<div class="page-container mx-auto" style="max-width: 800px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">EVENT DETAILS</h3>

    <div class="p-4 mb-4" style="background-color: #111111; border-radius: 8px;">
        <div class="row mb-4">
            <div class="col-6 border-end border-secondary">
                <label class="form-label text-muted d-block mb-1">EVENT NAME</label>
                <span class="text-white fs-4 fw-bold">@Model.Description</span>
            </div>
            <div class="col-6 ps-4">
                <label class="form-label text-muted d-block mb-1">LOCATION</label>
                <span class="text-white fs-5">@Model.Location</span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6 border-end border-secondary">
                <label class="form-label text-muted d-block mb-1">DATES</label>
                <span class="text-white fs-5">@(Model.StartDate?.ToString("MM/dd/yyyy") ?? "TBD") - @(Model.EndDate?.ToString("MM/dd/yyyy") ?? "TBD")</span>
            </div>
            <div class="col-6 ps-4">
                <label class="form-label text-muted d-block mb-1">STATUS</label>
                <span class="badge bg-dark border border-secondary text-white fs-6">@Model.Status</span>
            </div>
        </div>

        <div class="text-center pt-3 border-top border-secondary">
            <label class="form-label text-muted d-block mb-1">PRIZE POOL</label>
            <span class="text-val-orange fs-3 fw-bold font-monospace">$@(Math.Floor(Model.Price ?? 0))</span>
        </div>
    </div>

    <div class="row pt-2">
        <div class="col-6">
            <a asp-action="Edit" asp-route-id="@Model?.TournamentId" class="btn btn-primary w-100">EDIT EVENT</a>
        </div>
        <div class="col-6">
            <a asp-action="Index" class="btn-outline-val w-100">BACK TO LIST</a>
        </div>
    </div>
</div>