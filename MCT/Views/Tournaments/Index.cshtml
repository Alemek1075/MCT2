@model IEnumerable<MCT.Models.Tournament>
@{
    ViewData["Title"] = "EVENTS";
}

<div class="d-flex justify-content-between align-items-end mb-3 mt-3">
    <h2 class="mb-0 text-white">EVENTS</h2>
    <a asp-action="Create" class="btn-outline-val">CREATE NEW</a>
</div>

<div class="page-container mt-0 p-4">
    <table class="table table-dark table-borderless table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th class="text-white">EVENT NAME</th>
                <th class="text-white">LOCATION</th>
                <th class="text-white">START DATE</th>
                <th class="text-white">END DATE</th>
                <th class="text-white">PRIZE</th>
                <th class="text-white">STATUS</th>
                <th class="text-end text-white">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold fs-5 text-white">@item.Description</td>
                    <td class="text-white fs-6">@item.Location</td>
                    <td class="text-white fs-6">@(item.StartDate?.ToString("MM/dd/yyyy") ?? "TBD")</td>
                    <td class="text-white fs-6">@(item.EndDate?.ToString("MM/dd/yyyy") ?? "TBD")</td>
                    <td class="text-val-orange fw-bold fs-5">$@(Math.Floor(item.Price ?? 0))</td>
                    <td><span class="badge bg-dark border border-secondary fs-6 text-white">@item.Status</span></td>
                    <td class="text-end action-links">
                        <a asp-action="Edit" asp-route-id="@item.TournamentId">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.TournamentId">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.TournamentId" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>