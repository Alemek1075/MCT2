@model IEnumerable<MCT.Models.Tournament>

@{
    ViewData["Title"] = "Tournaments";
}

<h1>Tournaments</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Create Tournament</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Prize Pool</th>
            <th>Places</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Location</td>
                <td>@item.Price</td>
                <td>@item.Places</td>
                <td>@(item.StartDate?.ToShortDateString() ?? "-")</td>
                <td>@(item.EndDate?.ToShortDateString() ?? "-")</td>
                <td>
                    @if (item.CurrentStatus == "Planned")
                    {
                        <span class="badge bg-secondary">Planned</span>
                    }
                    else if (item.CurrentStatus == "Ongoing")
                    {

                        <span class="badge bg-success">Ongoing</span>
                    }
                    else
                    {

                        <span class="badge bg-primary">Completed</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TournamentId" class="btn btn-sm btn-info">Details</a>
                    <form asp-action="Delete" asp-route-id="@item.TournamentId" method="post" class="d-inline" onsubmit="return confirm('УВАГА: Видалення турніру також видалить ВСІ пов\'язані з ним матчі! Ви дійсно хочете продовжити?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>