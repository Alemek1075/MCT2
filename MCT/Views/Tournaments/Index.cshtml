@model IEnumerable<MCT.Models.Tournament>
@{
    ViewData["Title"] = "EVENTS";
}

<div class="page-container mx-auto" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">TOURNAMENTS</h3>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">CREATE NEW EVENT</a>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger font-monospace border border-danger bg-dark text-danger fw-bold mb-4 px-3 py-2">
            [ACCESS_DENIED] @TempData["ErrorMessage"]
        </div>
    }

    <div class="val-card p-4">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead class="text-muted border-bottom border-secondary" style="font-size: 0.85rem;">
                <tr>
                    <th class="fw-normal">EVENT NAME</th>
                    <th class="fw-normal">LOCATION</th>
                    <th class="fw-normal">START DATE</th>
                    <th class="fw-normal">STATUS</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string displayStatus = "TBA";
                    string statusClass = "bg-secondary";

                    if (item.StartDate.HasValue && item.EndDate.HasValue)
                    {
                        var now = DateTime.UtcNow.Date;
                        if (now < item.StartDate.Value.Date)
                        {
                            displayStatus = "Planned";
                        }
                        else if (now > item.EndDate.Value.Date)
                        {
                            displayStatus = "Completed";
                            statusClass = "bg-primary";
                        }
                        else
                        {
                            displayStatus = "Ongoing";
                            statusClass = "bg-success";
                        }
                    }

                    <tr class="border-bottom border-secondary" style="height: 60px;">
                        <td class="text-white fw-bold fs-5">@item.Description</td>
                        <td>@item.Location</td>
                        <td class="font-monospace">@(item.StartDate?.ToString("MM/dd/yyyy") ?? "TBA")</td>
                        <td><span class="badge @statusClass border border-secondary" style="letter-spacing: 1px;">@displayStatus</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.TournamentId" class="btn btn-outline-val btn-action-sm">DETAILS</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.TournamentId" class="btn btn-primary btn-action-sm">EDIT</a>
                                    <form asp-action="Delete" asp-route-id="@item.TournamentId" method="post" class="m-0 p-0 d-inline-flex">
                                        <button type="submit" class="btn btn-danger-val btn-action-sm" onclick="return confirm('Delete event?');">DELETE</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>