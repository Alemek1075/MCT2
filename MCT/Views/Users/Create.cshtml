@model MCT.Models.User
@{
    ViewData["Title"] = "CREATE USER";
}

<div class="page-container mx-auto" style="max-width: 500px;">
    <h3 class="text-val-red mb-4 border-bottom border-secondary pb-2">CREATE NEW USER</h3>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold bg-dark p-2 border border-danger rounded"></div>
        
        <div class="mb-3">
            <label asp-for="Username" class="form-label">USERNAME</label>
            <input asp-for="Username" class="form-control" required />
            <span asp-validation-for="Username" class="text-danger fw-bold d-block mt-1"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">EMAIL</label>
            <input asp-for="Email" type="email" class="form-control" required />
            <span asp-validation-for="Email" class="text-danger fw-bold d-block mt-1"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PasswordHash" class="form-label">PASSWORD HASH</label>
            <input asp-for="PasswordHash" class="form-control" required />
            <span asp-validation-for="PasswordHash" class="text-danger fw-bold d-block mt-1"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Role" class="form-label">ASSIGN ROLE</label>
            <select asp-for="Role" class="form-select" asp-items="ViewBag.Role"></select>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
            <a asp-action="Index" class="btn-outline-val">CANCEL</a>
            <button type="submit" class="btn btn-primary">CREATE USER</button>
        </div>
    </form>
</div>