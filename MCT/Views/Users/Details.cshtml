@model MCT.Models.User
@{
    ViewData["Title"] = "USER DETAILS";
    string roleClass = Model.Role switch
    {
        "Admin" => "bg-danger",
        "User" => "bg-success",
        "Player" => "",
        _ => "bg-secondary"
    };
    string roleStyle = Model.Role == "Player" ? "background-color: #0d47a1; color: #ece8e1;" : "";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary mb-4 pb-2">
        <h3 class="text-val-red m-0">USER PROFILE</h3>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary btn-action-sm">EDIT USER</a>
            <a asp-action="Index" class="btn-outline-val btn-action-sm">BACK</a>
        </div>
    </div>

    <div class="val-card p-5 text-center">
        <h1 class="text-white m-0" style="font-size: 3.5rem;">@Model.Username</h1>
        <h5 class="text-muted mt-2 font-monospace">@Model.Email</h5>
        
        <div class="mt-5 pt-4 border-top border-secondary">
            <p class="text-muted mb-1 form-label">SYSTEM ROLE</p>
            <span class="badge @roleClass border border-secondary px-4 py-2 fs-5 mt-2" style="letter-spacing: 1px; @roleStyle">@Model.Role</span>
        </div>
    </div>
</div>