@model MCT.Models.User
@{
    ViewData["Title"] = "EDIT USER";
}

<div class="page-container mx-auto" style="max-width: 600px;">
    <h2 class="mb-4 text-val-red">EDIT USER</h2>
    
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="UserId" />
        
        <div class="mb-3">
            <label asp-for="Username" class="control-label">USERNAME</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="control-label">EMAIL</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PasswordHash" class="control-label">PASSWORD HASH</label>
            <input asp-for="PasswordHash" class="form-control" />
            <span asp-validation-for="PasswordHash" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Role" class="control-label">ROLE</label>
            <select asp-for="Role" class="form-select" asp-items="ViewBag.Role">
                <option value="">-- SELECT ROLE --</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <a asp-action="Index" class="btn-outline-val border-0 px-0">CANCEL</a>
            <input type="submit" value="SAVE CHANGES" class="btn btn-primary" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}