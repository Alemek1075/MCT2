@model IEnumerable<MCT.Models.User>
@{
    ViewData["Title"] = "USERS";
}

<div class="d-flex justify-content-between align-items-end mb-3 mt-3">
    <h2 class="mb-0 text-white">USERS</h2>
    <a asp-action="Create" class="btn-outline-val">CREATE NEW</a>
</div>

<div class="page-container mt-0 p-4">
    <table class="table table-dark table-borderless table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th class="text-white">USERNAME</th>
                <th class="text-white">EMAIL</th>
                <th class="text-white">ROLE</th>
                <th class="text-end text-white">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string roleColor = "text-white";
                var roleName = item.RoleNavigation?.RoleName;
            
                if (roleName == "Admin") roleColor = "text-danger";
                else if (roleName == "Player") roleColor = "text-success";
                else if (roleName == "User") roleColor = "text-info";
            
                <tr>
                    <td class="fw-bold fs-5 text-white">@Html.DisplayFor(modelItem => item.Username)</td>
                    <td class="text-white fs-6">@Html.DisplayFor(modelItem => item.Email)</td>
                    <td><span class="badge bg-dark border border-secondary @roleColor fs-6">@(roleName ?? "TBD")</span></td>
                    <td class="text-end action-links">
                        <a asp-action="Edit" asp-route-id="@item.UserId">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.UserId">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.UserId" class="text-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>